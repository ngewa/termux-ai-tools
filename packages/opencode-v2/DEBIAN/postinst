#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

PREFIX=${PREFIX:-/data/data/com.termux/files/usr}
VERSION="2.2.0"
TARFILE="opencode-linux-arm64.tar.gz"
DOWNLOAD_URL="https://github.com/anomalyco/opencode/releases/download/v${VERSION}/${TARFILE}"
SHA256="1f1ce0fc07b9245a815ffa9d652dbb80e6b0f07e5bf74ea87d2b1c0339fbac52"
SHARE_DIR="$PREFIX/share/opencode-v2"
BIN_DIR="$PREFIX/bin"
LOADER="$PREFIX/glibc/lib/ld-linux-aarch64.so.1"
LIB_PATH="$PREFIX/glibc/lib"
TMPDIR=${TMPDIR:-$PREFIX/tmp}

die() {
    echo "opencode-v2: $*" >&2
    exit 1
}

[ "$(uname -m)" = "aarch64" ] ||
    die "only aarch64 is supported"
[ -x "$LOADER" ] ||
    die "glibc loader not found; install glibc-repo and glibc"

STAGE=$(mktemp -d "$TMPDIR/opencode-v2.XXXXXX")
trap 'rm -rf "$STAGE"' EXIT

echo "Downloading OpenCode 2 ${VERSION} from GitHub releases..."
curl -fL --retry 3 --max-time 600 -o "$STAGE/$TARFILE" "$DOWNLOAD_URL"
printf '%s  %s\n' "$SHA256" "$STAGE/$TARFILE" | sha256sum -c - >/dev/null ||
    die "checksum mismatch"
tar -xzf "$STAGE/$TARFILE" -C "$STAGE"
[ -f "$STAGE/opencode" ] ||
    die "OpenCode 2 binary not found in archive"

rm -rf "$SHARE_DIR"
mkdir -p "$SHARE_DIR" "$BIN_DIR"
patchelf --set-interpreter "$LOADER" "$STAGE/opencode"
mv "$STAGE/opencode" "$SHARE_DIR/opencode.real"
chmod 755 "$SHARE_DIR/opencode.real"


if [ -d "$PREFIX/glibc/etc" ] && [ -x "$PREFIX/glibc/bin/ldconfig" ]; then
    mkdir -p "$PREFIX/glibc/etc"
    if ! grep -qsF "$LIB_PATH" "$PREFIX/glibc/etc/ld.so.conf"; then
        echo "$LIB_PATH" >> "$PREFIX/glibc/etc/ld.so.conf"
    fi
    chmod 644 "$PREFIX/glibc/etc/ld.so.conf" 2>/dev/null || true
    "$PREFIX/glibc/bin/ldconfig" >/dev/null 2>&1 || true
fi

cat > "$STAGE/opencode-v2.c" <<'C_EOF'
#include <stdlib.h>
#include <unistd.h>
#include <stdio.h>

int main(int argc, char** argv) {
    unsetenv("LD_PRELOAD");
    unsetenv("LD_LIBRARY_PATH");

    setenv("GODEBUG", "netdns=cgo", 1);
    setenv("SSL_CERT_FILE", "/data/data/com.termux/files/usr/etc/tls/cert.pem", 1);

    char real_bin[] = "/data/data/com.termux/files/usr/share/opencode-v2/opencode.real";

    char** new_argv = malloc((argc + 1) * sizeof(char*));
    if (!new_argv) {
        return 1;
    }

    new_argv[0] = real_bin;
    for (int i = 1; i < argc; i++) {
        new_argv[i] = argv[i];
    }
    new_argv[argc] = NULL;

    execv(real_bin, new_argv);
    perror("execv");
    free(new_argv);
    return 1;
}
C_EOF

clang -O2 -o "$BIN_DIR/opencode-v2" "$STAGE/opencode-v2.c"
chmod 755 "$BIN_DIR/opencode-v2"

if timeout 60 "$BIN_DIR/opencode-v2" --version >/dev/null; then
    echo "OpenCode 2 ${VERSION} installed successfully."
else
    die "OpenCode 2 failed to start"
fi
echo "Run 'opencode-v2' to start."
